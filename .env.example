# ==============================================================================
# Railway Environment Variables Configuration
# ==============================================================================

# Server Port (Railway automatically sets the PORT variable during deployment)
PORT=3000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or Railway MongoDB Plugin)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchparty?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchparty?retryWrites=true&w=majority

# NextAuth Secret (Random 32-character string used to hash JWT tokens and session cookies)
# Generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secret_key_here_change_in_production

# NextAuth Canonical URL (The public domain assigned to your app by Railway)
# Example: https://watchparty-production.up.railway.app
NEXTAUTH_URL=https://your-app-name.up.railway.app
